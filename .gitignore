# Keep the repository limited to the LaTeX source and the assets needed to compile it.
*
!.gitignore
!README.md
!*.tex
!*.bib
!*.cls
!*.sty
!*.ttf
!*.eps
!*.png

# LaTeX/XeLaTeX build products
*.aux
*.bbl
*.blg
*.brf
*.fdb_latexmk
*.fls
*.idx
*.ilg
*.ind
*.lof
*.log
*.lot
*.out
*.synctex.gz
*.toc
*.xdv
*.pdf

# Local source collections and experimental code are not part of the thesis source.
/template-Tmodares/
/thesis/
/my-yolo-model/

# Editor and operating-system files
.vscode/
.idea/
Thumbs.db
.DS_Store
